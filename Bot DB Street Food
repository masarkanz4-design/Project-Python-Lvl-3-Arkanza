@bot.event
async def on_ready():
    setup_db()
    print(f"✓ Bot {bot.user.name} berhasil aktif dan database siap!")


# 6. COMMAND !cari KERAK TELOR
@bot.command(name="cari")
async def cari_street_food(ctx, *, keyword: str):
    conn = get_connection()
    cursor = conn.cursor()

    query = """
    SELECT nama_makanan, asal_negara, kategori, deskripsi 
    FROM street_food 
    WHERE LOWER(nama_makanan) LIKE LOWER(?) 
       OR LOWER(asal_negara) LIKE LOWER(?)
       OR LOWER(kategori) LIKE LOWER(?)
    """
    search_term = f"%{keyword}%"

    try:
        cursor.execute(query, (search_term, search_term, search_term))
        results = cursor.fetchall()
        conn.close()

        if not results:
            await ctx.send(
                f"🔍 Makanan dengan kata kunci **'{keyword}'** tidak ditemukan."
            )
            return

        embed = discord.Embed(
            title=f"🔍 Hasil Pencarian: '{keyword}'", color=discord.Color.gold()
        )

        for item in results:
            nama, negara, kategori, deskripsi = item
            embed.add_field(
                name=f"📌 {nama} ({negara})",
                value=f"**Kategori:** {kategori}\n**Deskripsi:** {deskripsi}",
                inline=False,
            )

        await ctx.send(embed=embed)

    except Exception as e:
        await ctx.send(f"❌ Error Database: {e}")


# 7. JALANKAN BOT
bot.run(TOKEN)

